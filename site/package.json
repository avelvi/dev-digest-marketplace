{
  "name": "dev-digest-marketplace-site",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "Static web catalog for the dev-digest-marketplace, built with Vite and hosted on GitHub Pages",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "catalog": "tsx scripts/build-catalog.ts",
    "catalog:fixtures": "tsx scripts/build-catalog.ts --root tests/fixtures/full",
    "dev": "vite",
    "build": "npm run catalog && tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^20.19.43",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "axe-core": "^4.14.0",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "gray-matter": "^4.0.3",
    "jsdom": "^27.4.0",
    "tsx": "^4.23.15",
    "typescript": "~5.9",
    "typescript-eslint": "^8.71.2",
    "vite": "^7.3.7",
    "vitest": "^3.2.7"
  }
}
